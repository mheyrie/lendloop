# Copy to .env.n8n (git-ignored). On n8n Cloud, create these as Variables instead.
# Secret n8n uses to VERIFY webhooks from Convex. Must equal Convex's N8N_WEBHOOK_SECRET.
LENDLOOP_N8N_WEBHOOK_SECRET=
# Secret n8n uses to SIGN calls to Convex. Must equal Convex's LENDLOOP_API_SECRET.
LENDLOOP_API_SECRET=
# Convex HTTP actions base URL, e.g. https://happy-otter-123.convex.site
# (local Convex backend from Docker: http://host.docker.internal:3211)
LENDLOOP_CONVEX_SITE_URL=
# Optional: path part of N8N_LOAN_EVENTS_WEBHOOK_URL if you changed it
# LENDLOOP_WEBHOOK_PATH=/webhook/lendloop-loan-events
# Optional: set to true to exercise the failure / retry / error-workflow path
# LENDLOOP_SIMULATE_FAILURE=false
# Required to encrypt n8n credentials at rest: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
