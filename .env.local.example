# Next.js (copy to .env.local). `npx convex dev` fills in the CONVEX_* values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/tools

# These are Convex deployment env vars, NOT Next.js ones. Set them with
#   npx convex env set NAME value
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev
# N8N_LOAN_EVENTS_WEBHOOK_URL=https://<you>.app.n8n.cloud/webhook/lendloop-loan-events
# N8N_WEBHOOK_SECRET=<openssl rand -hex 32>
# LENDLOOP_API_SECRET=<openssl rand -hex 32, different from the one above>
